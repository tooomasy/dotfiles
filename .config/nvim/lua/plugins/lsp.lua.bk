-- lsp.lua ── Modern Native LSP Setup (Neovim 0.11+ style, 2026 best practices)

return {
	-- 1. Treesitter ── 語法解析基礎（highlight, indent, textobjects）
	{
		"nvim-treesitter/nvim-treesitter",
		build = ":TSUpdate",
		config = function()
			require("nvim-treesitter.configs").setup({
				ensure_installed = {
					"bash",
					"c",
					"cpp",
					"css",
					"html",
					"javascript",
					"json",
					"lua",
					"luadoc",
					"markdown",
					"markdown_inline",
					"python",
					"query",
					"rust",
					"tsx",
					"typescript",
					"vim",
					"vimdoc",
					"yaml",
				},
				auto_install = true,
				highlight = { enable = true, additional_vim_regex_highlighting = { "ruby" } },
				indent = { enable = true, disable = { "ruby" } },
				incremental_selection = { enable = true },
				textobjects = { enable = true },
			})
		end,
	},

	-- 2. Mason ── 工具管理器（LSP servers, formatters, linters）
	{
		"williamboman/mason.nvim",
		dependencies = {
			"williamboman/mason-lspconfig.nvim",
			"WhoIsSethDaniel/mason-tool-installer.nvim",
		},
		config = function()
			require("mason").setup()
			require("mason-tool-installer").setup({
				ensure_installed = {
					-- LSP servers
					"lua_ls",
					"pyright",
					"clangd",
					"ts_ls",
					"rust_analyzer",
					-- Formatters
					"stylua",
					"black",
					"prettier",
					-- Linters (optional, if you want extra checking)
					"flake8",
					"eslint_d",
				},
				auto_update = true,
			})
		end,
	},

	-- 3. Core LSP ── 原生配置 + blink.cmp capabilities
	{
		"neovim/nvim-lspconfig", -- 雖然 deprecated 舊 API，但我們仍需它來取預設 configs
		dependencies = {
			"saghen/blink.cmp", -- completion
			"j-hui/fidget.nvim", -- LSP 進度 UI
		},
		config = function()
			require("fidget").setup({})

			-- Capabilities from blink.cmp (支援 snippet, completion 等)
			local capabilities = require("blink.cmp").get_lsp_capabilities()

			-- 定義所有 servers 的設定（可擴展）
			local servers = {
				lua_ls = {
					settings = {
						Lua = {
							runtime = { version = "LuaJIT" },
							diagnostics = { globals = { "vim" } },
							workspace = { checkThirdParty = false, library = vim.api.nvim_get_runtime_file("", true) },
							telemetry = { enable = false },
							completion = { callSnippet = "Replace" },
						},
					},
				},

				pyright = {
					settings = {
						python = {
							analysis = {
								autoSearchPaths = true,
								useLibraryCodeForTypes = true,
								diagnosticMode = "workspace",
							},
						},
					},
					-- 如果你常用 uv / venv，這裡可留空，pyright 會自動偵測
				},

				clangd = {
					cmd = { "clangd", "--background-index", "--clang-tidy" },
				},

				ts_ls = {}, -- TypeScript / JS

				rust_analyzer = {
					settings = {
						["rust-analyzer"] = {
							check = { command = "clippy" },
							imports = { granularity = { group = "module" } },
						},
					},
				},
			}

			-- 統一啟用所有 servers
			for name, opts in pairs(servers) do
				vim.lsp.config(
					name,
					vim.tbl_deep_extend("force", {
						capabilities = capabilities,
						-- 你可以加 root_markers = { ".git", "pyproject.toml" } 等自訂 root 偵測
					}, opts)
				)
				vim.lsp.enable(name)
			end

			-- LspAttach 事件：綁定 keymaps、inlay hints、highlight 等
			vim.api.nvim_create_autocmd("LspAttach", {
				group = vim.api.nvim_create_augroup("yin-lsp-attach", { clear = true }),
				callback = function(event)
					local bufnr = event.buf
					local client = vim.lsp.get_client_by_id(event.data.client_id)

					local map = function(mode, lhs, rhs, desc)
						vim.keymap.set(mode, lhs, rhs, { buffer = bufnr, desc = "LSP: " .. desc })
					end

					-- 常用 keymaps（可自訂）
					map("n", "gd", vim.lsp.buf.definition, "Goto Definition")
					map("n", "gD", vim.lsp.buf.declaration, "Goto Declaration")
					map("n", "gi", vim.lsp.buf.implementation, "Goto Implementation")
					map("n", "gr", vim.lsp.buf.references, "References")
					map("n", "gt", vim.lsp.buf.type_definition, "Type Definition")
					map("n", "<leader>rn", vim.lsp.buf.rename, "Rename")
					map({ "n", "v" }, "<leader>ca", vim.lsp.buf.code_action, "Code Action")
					map("n", "K", vim.lsp.buf.hover, "Hover Documentation")
					map("n", "<leader>ds", require("telescope.builtin").lsp_document_symbols, "Document Symbols")

					-- Inlay hints toggle
					if client.supports_method("textDocument/inlayHint") then
						map("n", "<leader>th", function()
							vim.lsp.inlay_hint.enable(not vim.lsp.inlay_hint.is_enabled({ bufnr = bufnr }))
						end, "Toggle Inlay Hints")
						vim.lsp.inlay_hint.enable(not vim.lsp.inlay_hint.is_enabled({ bufnr = bufnr }))
					end

					-- Reference 高亮
					if client.supports_method("textDocument/documentHighlight") then
						local hi_group = vim.api.nvim_create_augroup("yin-lsp-highlight", { clear = false })
						vim.api.nvim_create_autocmd({ "CursorHold", "CursorHoldI" }, {
							buffer = bufnr,
							group = hi_group,
							callback = vim.lsp.buf.document_highlight,
						})
						vim.api.nvim_create_autocmd({ "CursorMoved", "CursorMovedI" }, {
							buffer = bufnr,
							group = hi_group,
							callback = vim.lsp.buf.clear_references,
						})
					end
				end,
			})

			-- Diagnostics 顯示（業界標準：severity sort + signs + virtual text）
			vim.diagnostic.config({
				virtual_text = { prefix = "●", spacing = 4, source = "if_many" },
				signs = true,
				underline = true,
				update_in_insert = false,
				severity_sort = true,
				float = { border = "rounded", source = "always", max_width = 80 },
			})
		end,
	},

	-- 4. Formatting ── conform.nvim（lsp fallback 很穩）
	{
		"stevearc/conform.nvim",
		event = { "BufWritePre" },
		cmd = { "ConformInfo" }, -- :ConformInfo 看狀態
		keys = {
			{
				"<leader>f", -- 手動格式化當前 buffer
				function()
					require("conform").format({ async = true, lsp_format = "fallback" })
				end,
				mode = "",
				desc = "Code [F]ormat",
			},
		},
		opts = {
			format_on_save = { timeout_ms = 500, lsp_format = "fallback" },
			formatters_by_ft = {
				lua = { "stylua" },
				python = { "black" },
				c = { "clang_format" },
				cpp = { "clang_format" },
				javascript = { "prettier", "prettierd", stop_after_first = true },
				typescript = { "prettier", "prettierd", stop_after_first = true },
				["*"] = { "trim_whitespace" },
			},
			formatters = {
				clang_format = {
					prepend_args = { "--style=file", "--fallback-style=Google" }, -- 用 Google 風格（或 LLVM、WebKit、Microsoft）
				},
				black = {
					prepend_args = { "--line-length=88" }, -- black 預設 88，可改
				},
				prettier = {
					prepend_args = { "--single-quote", "--trailing-comma=all" },
				},
			},
		},
	},

	-- 5. Completion ── blink.cmp（保持你的原設定，但優化）
	{
		"saghen/blink.cmp",
		event = "InsertEnter",
		dependencies = {
			-- "rafamadriz/friendly-snippets", -- 內建大量 snippets，保持
		},
		-- 如果你已經確認 rust fuzzy binary 正常，這行可以保留
		-- build = "cargo build --release",

		opts = {
			-- 關鍵：啟用 super-tab preset，讓 Tab 行為最自然
			keymap = {
				preset = "super-tab", -- 這一行就讓 Tab 變成：
				-- 1. 沒 menu 時 → 開 menu
				-- 2. 有 menu 時 → 向下選擇下一項
				-- 3. 再 Tab → 接受目前選中的
				-- 4. snippet 展開中 → 跳下一個 placeholder
				-- Shift-Tab → 向上選擇或 snippet 後退
				["<C-e>"] = { "cancel", "fallback" },
			},

			-- 補全列表行為（讓 Tab 更順）
			completion = {
				list = {
					selection = {
						preselect = false, -- 不預先選第一項，讓你自己 Tab 選
						auto_insert = true, -- 選中後自動插入（VS Code 風格）
					},
				},
				menu = {
					auto_show = true, -- 打字後自動彈出
				},
				keyword = {
					range = "prefix", -- prefix 通常最靈敏
				},
				trigger = {
					show_on_trigger_characters = true,
					show_on_insert_on_trigger_character = true,
				},
				documentation = {
					auto_show = true,
					auto_show_delay_ms = 150, -- 再降一點，感覺更快
				},
				accept = {
					auto_brackets = { enabled = false }, -- 如果不需要自動括號，關掉避免怪異
					create_undo = true, -- 允許 undo
				},
			},

			-- 來源優先級（你原有的很好，snippets 優先）
			sources = {
				default = { "snippets", "lsp", "path", "buffer" }, -- snippets 第一
				providers = {
					snippets = { score_offset = 5 }, -- 最高優先，讓 snippet 先跳出來
					lsp = { score_offset = 1, async = true }, -- LSP 慢也沒關係
					path = { score_offset = 3 },
					buffer = { score_offset = 2 },
				},
			},

			-- fuzzy 保持 rust（性能最佳）
			fuzzy = { implementation = "rust" },

			-- signature help 開啟（函數參數提示）
			signature = { enabled = true },

			-- snippets 用原生 default（最快）
			snippets = {
				preset = "default",
				-- friendly_snippets = true,
				-- 如果你有自訂 snippet，可加：
				-- search_paths = { vim.fn.stdpath("config") .. "/snippets" },
			},
		},
	},
}
